{
    "name": "http-proxy-inspector",
    "version": "1.0.0",
    "description": "Local reverse proxies that forward to your real APIs and capture every request and response in a web UI. Great with Next.js, works with any HTTP client (dev-only).",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "http-proxy-inspector": "dist/cli.js"
    },
    "files": [
        "dist",
        "ui"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "build": "npm run clean && tsc",
        "dev": "tsc --watch",
        "start": "node dist/cli.js",
        "test": "npm run build && node --test test/*.test.js",
        "prepublishOnly": "npm test"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "author": "Jhon Parra",
    "license": "MIT",
    "homepage": "https://github.com/JhonSteven/http-proxy-inspector#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JhonSteven/http-proxy-inspector.git"
    },
    "bugs": {
        "url": "https://github.com/JhonSteven/http-proxy-inspector/issues"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "http",
        "proxy",
        "reverse-proxy",
        "inspector",
        "network",
        "api",
        "debug",
        "devtools",
        "development",
        "nextjs",
        "react",
        "sse"
    ]
}
